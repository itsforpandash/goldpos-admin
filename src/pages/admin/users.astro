---
import Layout from '@/layouts/Layout.astro';
import Flash from '@/components/admin/flash.astro';
import { UserService } from '@/lib/services/user';
import { toPersianDigits, formatPersianDate } from '@/lib/i18n';

const { DB } = Astro.locals.runtime.env;
const userService = new UserService(DB);
const users = await userService.getAll();

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
---

<Layout title="کاربران">
  <Flash ok={ok} err={err} />

  <details class="kpi-card mb-6" open={!!err}>
    <summary class="cursor-pointer font-bold text-lg select-none">+ افزودن کاربر جدید</summary>
    <form method="post" action="/admin/users/create" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <label class="block text-xs text-muted-foreground mb-1">نام کاربری *</label>
        <input type="text" name="username" required minlength="3" placeholder="m.ahmadi" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">نام کامل *</label>
        <input type="text" name="full_name" required minlength="2" placeholder="محمد احمدی" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">شماره موبایل *</label>
        <input type="tel" name="phone" required minlength="5" placeholder="09121234567" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" dir="ltr" />
      </div>
      <div class="flex items-end">
        <button type="submit" class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
          ایجاد کاربر
        </button>
      </div>
    </form>
  </details>

  <div class="rounded-md border border-border overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-muted/50">
        <tr class="text-right">
          <th class="px-4 py-3 font-medium text-muted-foreground">شناسه</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">نام کاربری</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">نام</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">شماره موبایل</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">وضعیت</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">نقش</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">تاریخ ثبت</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {users.length === 0 ? (
          <tr>
            <td colspan="8" class="h-24 text-center text-muted-foreground">
              کاربری ثبت نشده. از فرم بالا اولین کاربر را ایجاد کنید.
            </td>
          </tr>
        ) : (
          users.map((user: any) => (
            <tr class="border-t border-border hover:bg-muted/30 transition-colors">
              <td class="px-4 py-3 font-mono text-xs">{toPersianDigits(user.id)}</td>
              <td class="px-4 py-3 font-mono text-xs" dir="ltr">{user.username}</td>
              <td class="px-4 py-3 font-medium">{user.full_name}</td>
              <td class="px-4 py-3 font-mono text-xs" dir="ltr">{user.phone}</td>
              <td class="px-4 py-3">
                <span class={`px-2 py-1 rounded-full text-xs ${
                  user.status === 'active' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' :
                  user.status === 'suspended' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300' :
                  'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300'
                }`}>
                  {user.status === 'active' ? 'فعال' : user.status === 'suspended' ? 'معلق' : 'غیرفعال'}
                </span>
              </td>
              <td class="px-4 py-3">{user.role}</td>
              <td class="px-4 py-3 text-muted-foreground">{formatPersianDate(user.created_at)}</td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <form method="post" action="/admin/users/action" class="inline">
                    <input type="hidden" name="id" value={user.id} />
                    <input type="hidden" name="action" value={user.status === 'active' ? 'suspend' : 'activate'} />
                    <button type="submit" class="rounded border border-border px-2 py-1 text-xs hover:bg-muted transition-colors">
                      {user.status === 'active' ? 'تعلیق' : 'فعال‌سازی'}
                    </button>
                  </form>
                  <form method="post" action="/admin/users/action" class="inline" onsubmit="return confirm('این کاربر حذف شود؟ (فقط در صورت نداشتن لایسنس)')">
                    <input type="hidden" name="id" value={user.id} />
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950 transition-colors">
                      حذف
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</Layout>
