---
import Layout from '@/layouts/Layout.astro';
import { AdminUserService } from '@/lib/services/admin';

// Same ?ok= / ?err= contract as the other admin pages; messages are rendered here
// (instead of via <Flash/>) because they are password-specific.
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

const okMap: Record<string, string> = {
  changed: 'رمز عبور با موفقیت تغییر کرد.',
};

const errMap: Record<string, string> = {
  fields: 'فیلدهای فرم را کامل و صحیح وارد کنید.',
  current: 'رمز عبور فعلی اشتباه است.',
  burned: 'این رمز عبور قابل استفاده نیست؛ رمز پیش‌فرض قدیام/پیش‌فرض سیستم باید کاملاً کنار گذاشته شود.',
  weak: 'رمز عبور جدید باید حداقل ۱۲ کاراکتر باشد.',
  confirm: 'تکرار رمز عبور جدید مطابقت ندارد.',
  rate_limit: 'تعداد تلاش بیش از حد مجاز است. لطفاً کمی بعد دوباره تلاش کنید.',
  action: 'عملیات ناموفق بود.',
};

let message = '';
let tone = '';
if (ok) {
  message = okMap[ok] || 'عملیات با موفقیت انجام شد.';
  tone = 'success';
} else if (err) {
  message = errMap[err] || 'خطایی رخ داد.';
  tone = 'error';
}

const { DB } = Astro.locals.runtime.env;
const session = Astro.locals.SESSION;
if (!session?.id) {
  return Astro.redirect('/admin/login');
}

const adminRow = await new AdminUserService(DB).getWithHash(session.id);
if (!adminRow) {
  return Astro.redirect('/admin/login');
}
const mustChange = !!adminRow.must_change_password;
---

<Layout title="تغییر رمز عبور">
  {message && (
    <div
      class={`mb-4 rounded-md border px-4 py-3 text-sm ${
        tone === 'success'
          ? 'border-green-200 bg-green-50 text-green-800 dark:border-green-900 dark:bg-green-950 dark:text-green-300'
          : 'border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-300'
      }`}
      role="alert"
    >
      {message}
    </div>
  )}

  {mustChange && (
    <div class="mb-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200" role="alert">
      رمز عبور پیش‌فرض حساب شما در مخزن عمومی این پروژه قرار دارد و دیگر امن نیست.
      تا زمانی که رمز عبور جدیدی تعیین نکنید، این حساب برای انجام عملیات مدیریتی قابل استفاده نخواهد بود.
    </div>
  )}

  <div class="kpi-card max-w-xl">
    <p class="mb-4 text-sm text-muted-foreground">
      برای تغییر رمز عبور ابتدا رمز فعلی خود را وارد کنید. رمز جدید باید حداقل ۱۲ کاراکتر باشد
      و نباید از رمز پیش‌فرض سیستم استفاده کند.
    </p>

    <form method="post" action="/admin/change-password/submit" class="grid gap-4">
      <div>
        <label class="block text-xs text-muted-foreground mb-1" for="current_password">رمز عبور فعلی *</label>
        <input
          id="current_password"
          type="password"
          name="current_password"
          required
          autocomplete="current-password"
          class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm"
        />
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1" for="new_password">رمز عبور جدید *</label>
        <input
          id="new_password"
          type="password"
          name="new_password"
          required
          minlength="12"
          autocomplete="new-password"
          class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm"
        />
        <p class="mt-1 text-xs text-muted-foreground">حداقل ۱۲ کاراکتر</p>
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1" for="confirm_password">تکرار رمز عبور جدید *</label>
        <input
          id="confirm_password"
          type="password"
          name="confirm_password"
          required
          minlength="12"
          autocomplete="new-password"
          class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm"
        />
      </div>
      <div class="flex items-center gap-3">
        <button
          type="submit"
          class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          تغییر رمز عبور
        </button>
        {!mustChange && (
          <a href="/admin" class="text-sm text-muted-foreground hover:text-foreground">بازگشت به داشبورد</a>
        )}
      </div>
    </form>
  </div>
</Layout>
