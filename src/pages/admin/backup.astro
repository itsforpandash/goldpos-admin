---
import Layout from '@/layouts/Layout.astro';
import Flash from '@/components/admin/flash.astro';
import { BackupService } from '@/lib/services/backup';
import { toPersianDigits } from '@/lib/i18n';

const { DB } = Astro.locals.runtime.env;
const backupService = new BackupService(DB);
const backup = await backupService.exportAll();

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
---

<Layout title="پشتیبان‌گیری و بازیابی اطلاعات">
  <Flash ok={ok} err={err} />

  <!-- Database summary stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
    <div class="kpi-card">
      <p class="text-xs text-muted-foreground">کل کاربران</p>
      <p class="kpi-value text-primary mt-1">{toPersianDigits(backup.summary.total_users)}</p>
    </div>
    <div class="kpi-card">
      <p class="text-xs text-muted-foreground">کل لایسنس‌ها</p>
      <p class="kpi-value text-purple-600 mt-1">{toPersianDigits(backup.summary.total_licenses)}</p>
    </div>
    <div class="kpi-card">
      <p class="text-xs text-muted-foreground">دستگاه‌های ثبت‌شده</p>
      <p class="kpi-value text-amber-600 mt-1">{toPersianDigits(backup.summary.total_devices)}</p>
    </div>
    <div class="kpi-card">
      <p class="text-xs text-muted-foreground">پلن‌های اشتراک</p>
      <p class="kpi-value text-emerald-600 mt-1">{toPersianDigits(backup.summary.total_plans)}</p>
    </div>
    <div class="kpi-card">
      <p class="text-xs text-muted-foreground">گالری‌های طلا</p>
      <p class="kpi-value text-blue-600 mt-1">{toPersianDigits(backup.summary.total_galleries)}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Export Box -->
    <div class="kpi-card flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 flex items-center justify-center font-bold text-lg">
            💾
          </div>
          <div>
            <h3 class="font-bold text-lg">دانلود فایل پشتیبان کامل (JSON)</h3>
            <p class="text-xs text-muted-foreground mt-0.5">دریافت نسخه کامل دیتابیس شامل کاربران، لایسنس‌ها، دستگاه‌ها و اطلاعات گالری‌ها</p>
          </div>
        </div>

        <div class="bg-muted/40 rounded-lg p-3 text-xs space-y-1.5 mb-6 border border-border">
          <div class="flex justify-between">
            <span class="text-muted-foreground">فرمت خروجی:</span>
            <span class="font-mono">JSON استاندارد (D1 Snapshot)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted-foreground">سازگاری:</span>
            <span>Cloudflare D1 و محیط‌های لوکال</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted-foreground">رمزگذاری:</span>
            <span>UTF-8 با حفظ تمامی متون فارسی</span>
          </div>
        </div>
      </div>

      <a
        href="/api/admin/backup"
        download
        class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 px-4 transition-colors shadow-sm text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        <span>دانلود آنی فایل پشتیبان</span>
      </a>
    </div>

    <!-- Import Box -->
    <div class="kpi-card">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 flex items-center justify-center font-bold text-lg">
          📥
        </div>
        <div>
          <h3 class="font-bold text-lg">بازیابی و ایمپورت اطلاعات</h3>
          <p class="text-xs text-muted-foreground mt-0.5">بارگذاری فایل JSON پشتیبان برای برگرداندن داده‌ها یا انتقال سرور</p>
        </div>
      </div>

      <form id="import-form" class="space-y-4">
        <div>
          <label class="block text-xs text-muted-foreground mb-1">انتخاب فایل پشتیبان (.json) *</label>
          <input
            type="file"
            id="backup-file-input"
            accept=".json,application/json"
            required
            class="w-full text-xs rounded-md border border-border bg-background px-3 py-2 cursor-pointer file:me-3 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20"
          />
        </div>

        <div>
          <label class="block text-xs text-muted-foreground mb-1">روش بازیابی</label>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-2 p-2.5 rounded-lg border border-border bg-background cursor-pointer hover:border-primary">
              <input type="radio" name="import_mode" value="merge" checked class="text-primary" />
              <div>
                <span class="font-bold block">ادغام و به‌روزرسانی (پیشنهادی)</span>
                <span class="text-[10px] text-muted-foreground">بدون حذف داده‌های فعلی</span>
              </div>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-lg border border-border bg-background cursor-pointer hover:border-destructive">
              <input type="radio" name="import_mode" value="replace" class="text-destructive" />
              <div>
                <span class="font-bold block text-destructive">جایگزینی کامل</span>
                <span class="text-[10px] text-muted-foreground">پاکسازی و بازنویسی دقیق</span>
              </div>
            </label>
          </div>
        </div>

        <div id="import-status" class="hidden p-3 rounded-lg text-xs"></div>

        <button
          type="submit"
          id="import-submit-btn"
          class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground font-medium py-3 px-4 transition-colors text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
          <span id="import-btn-text">شروع بازیابی اطلاعات</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Cloudflare D1 Deployment Guide -->
  <div class="kpi-card border-dashed">
    <h3 class="font-bold text-base mb-2 flex items-center gap-2">
      <span>☁️</span>
      <span>راهنمای استقرار در Cloudflare و انتقال بدون افت اطلاعات</span>
    </h3>
    <p class="text-xs text-muted-foreground leading-relaxed">
      این پنل با معماری Cloudflare Workers و پایگاه‌داده توزیع‌شده Cloudflare D1 هماهنگ است. جهت انتقال امن اطلاعات به کانتینر جدید یا محیط Cloudflare:
    </p>
    <ul class="mt-3 space-y-1.5 text-xs text-muted-foreground list-disc list-inside">
      <li>پیش از هرگونه تغییر عمده یا استقرار نهایی، یک فایل پشتیبان JSON از دکمه بالا دانلود فرمایید.</li>
      <li>در صورت نیاز به اعمال مایگریشن‌ها در کلادفلر، دستور <code class="font-mono bg-muted px-1.5 py-0.5 rounded">npm run db:migrate:remote</code> را اجرا کنید.</li>
      <li>پس از راه‌اندازی دیتابیس D1 جدید در کلادفلر، با استفاده از فرم بالا می‌توانید تمام کاربران، پلن‌ها و لایسنس‌ها را با یک کلیک بازیابی فرمایید.</li>
    </ul>
  </div>
</Layout>

<script is:inline>
  document.getElementById('import-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = document.getElementById('backup-file-input');
    const statusDiv = document.getElementById('import-status');
    const submitBtn = document.getElementById('import-submit-btn');
    const btnText = document.getElementById('import-btn-text');

    if (!fileInput.files || fileInput.files.length === 0) {
      alert('لطفاً ابتدا فایل پشتیبان را انتخاب کنید');
      return;
    }

    const file = fileInput.files[0];
    const mode = document.querySelector('input[name="import_mode"]:checked')?.value || 'merge';

    if (mode === 'replace') {
      const confirmed = confirm('توجه: با انتخاب جایگزینی کامل، داده‌های کنونی بازنویسی خواهند شد. آیا اطمینان دارید؟');
      if (!confirmed) return;
    }

    submitBtn.disabled = true;
    btnText.textContent = 'در حال ارسال و بازیابی اطلاعات...';
    statusDiv.className = 'p-3 rounded-lg text-xs bg-muted text-muted-foreground';
    statusDiv.textContent = 'در حال خواندن فایل و پردازش در سرور...';
    statusDiv.classList.remove('hidden');

    try {
      const text = await file.text();
      let backupPayload;
      try {
        backupPayload = JSON.parse(text);
      } catch (err) {
        throw new Error('فرمت فایل انتخاب‌شده معتبر نیست (باید یک فایل JSON معتبر باشد).');
      }

      const res = await fetch('/api/admin/backup/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ backup: backupPayload, mode }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        statusDiv.className = 'p-3 rounded-lg text-xs bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300';
        const parts = Object.entries(data.imported || {})
          .map(([table, count]) => `${table}: ${count}`)
          .join(' | ');
        statusDiv.innerHTML = `<strong>بازیابی موفقیت‌آمیز بود!</strong><br><span class="text-[11px]">${parts}</span>`;
        setTimeout(() => window.location.reload(), 2500);
      } else {
        throw new Error(data.message || 'خطا در بازیابی اطلاعات');
      }
    } catch (err) {
      statusDiv.className = 'p-3 rounded-lg text-xs bg-red-50 text-red-800 dark:bg-red-950 dark:text-red-300 border border-red-300';
      statusDiv.textContent = err.message || 'خطای نامشخص در هنگام ارسال فایل';
      submitBtn.disabled = false;
      btnText.textContent = 'شروع مجدد بازیابی اطلاعات';
    }
  });
</script>
