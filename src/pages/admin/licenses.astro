---
import Layout from '@/layouts/Layout.astro';
import Flash from '@/components/admin/flash.astro';
import { LicenseService } from '@/lib/services/license';
import { UserService } from '@/lib/services/user';
import { PlanService } from '@/lib/services/plan';
import { toPersianDigits, formatPersianDate } from '@/lib/i18n';

const { DB } = Astro.locals.runtime.env;
const licenseService = new LicenseService(DB);
const userService = new UserService(DB);
const planService = new PlanService(DB);

const [licenses, users, plans] = await Promise.all([
  licenseService.getAll(),
  userService.getAll(),
  planService.getAll(),
]);

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
---

<Layout title="لایسنسها">
  <Flash ok={ok} err={err} />

  <!-- Quick Test Chips for Kotlin Mobile App (Royal Gold & Navy) -->
  <div class="kpi-card mb-6 border-amber-200 dark:border-amber-900/40 bg-gradient-to-l from-amber-500/5 via-card to-card">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">⚡</span>
        <div>
          <h3 class="font-bold text-sm text-foreground">کدهای تست سریع اپلیکیشن موبایل (Royal Gold)</h3>
          <p class="text-xs text-muted-foreground">جهت بررسی مستقیم روی چیپ‌های تست صفحه ورود کد اشتراک (Subscription Code Screen) در اپلیکیشن کاتلین</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
      <div class="p-3 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div class="flex justify-between items-center">
          <span class="font-bold text-blue-600 dark:text-blue-400">تست دمو (۷ روزه)</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">دمو</span>
        </div>
        <p class="text-[11px] text-muted-foreground">بررسی Splash، فعال‌سازی دستگاه و راه‌اندازی اطلاعات گالری</p>
        <form method="post" action="/admin/licenses/generate">
          <input type="hidden" name="user_id" value={users[0]?.id || 1} />
          <input type="hidden" name="plan_id" value={plans[0]?.id || 1} />
          <input type="hidden" name="quantity" value="1" />
          <input type="hidden" name="days" value="7" />
          <input type="hidden" name="max_devices" value="1" />
          <button type="submit" class="w-full py-1.5 px-3 rounded bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors cursor-pointer text-center">
            + صدور کد تست دمو (۷ روز)
          </button>
        </form>
      </div>

      <div class="p-3 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div class="flex justify-between items-center">
          <span class="font-bold text-amber-600 dark:text-amber-400">اشتراک ۳ ماهه</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">استاندارد</span>
        </div>
        <p class="text-[11px] text-muted-foreground">بررسی دوره مهلت آفلاین (Grace Period تا ۷ روز) و آنتی‌تمپرینگ</p>
        <form method="post" action="/admin/licenses/generate">
          <input type="hidden" name="user_id" value={users[0]?.id || 1} />
          <input type="hidden" name="plan_id" value={plans[1]?.id || plans[0]?.id || 1} />
          <input type="hidden" name="quantity" value="1" />
          <input type="hidden" name="days" value="90" />
          <input type="hidden" name="max_devices" value="2" />
          <button type="submit" class="w-full py-1.5 px-3 rounded bg-amber-600 hover:bg-amber-700 text-white font-medium transition-colors cursor-pointer text-center">
            + صدور کد ۳ ماهه
          </button>
        </form>
      </div>

      <div class="p-3 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div class="flex justify-between items-center">
          <span class="font-bold text-emerald-600 dark:text-emerald-400">اشتراک ۱ ساله (VIP)</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">سازمانی</span>
        </div>
        <p class="text-[11px] text-muted-foreground">پلن طلایی کامل با قابلیت چند دستگاهی و سربرگ رسمی فاکتور</p>
        <form method="post" action="/admin/licenses/generate">
          <input type="hidden" name="user_id" value={users[0]?.id || 1} />
          <input type="hidden" name="plan_id" value={plans[2]?.id || plans[0]?.id || 1} />
          <input type="hidden" name="quantity" value="1" />
          <input type="hidden" name="days" value="365" />
          <input type="hidden" name="max_devices" value="5" />
          <button type="submit" class="w-full py-1.5 px-3 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-medium transition-colors cursor-pointer text-center">
            + صدور کد ۱ ساله
          </button>
        </form>
      </div>
    </div>
  </div>

  <details class="kpi-card mb-6" open={!!err}>
    <summary class="cursor-pointer font-bold text-lg select-none">+ تولید لایسنس جدید</summary>
    <form method="post" action="/admin/licenses/generate" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <label class="block text-xs text-muted-foreground mb-1">کاربر</label>
        <select name="user_id" required class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm">
          <option value="">— انتخاب کاربر —</option>
          {users.map((u: any) => (
            <option value={u.id}>{u.full_name} ({u.phone})</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">پلن</label>
        <select name="plan_id" required class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm">
          <option value="">— انتخاب پلن —</option>
          {plans.filter((p: any) => p.status === 'active').map((p: any) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">تعداد</label>
        <input type="number" name="quantity" value="1" min="1" max="50" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">مدت (روز)</label>
        <input type="number" name="days" value="30" min="1" max="3650" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-muted-foreground mb-1">حداکثر دستگاه</label>
        <input type="number" name="max_devices" value="1" min="1" max="20" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" />
      </div>
      <div class="sm:col-span-2 lg:col-span-5">
        <button type="submit" class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
          تولید لایسنس
        </button>
      </div>
    </form>
  </details>

  <div class="table-scroll rounded-md border border-border">
    <table class="w-full min-w-[40rem] text-sm">
      <thead class="bg-muted/50">
        <tr class="text-right">
          <th class="px-4 py-3 font-medium text-muted-foreground">کد لایسنس</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">پلن</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">وضعیت</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">تعداد دستگاه</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">انقضا</th>
          <th class="px-4 py-3 font-medium text-muted-foreground">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {licenses.length === 0 ? (
          <tr>
            <td colspan="6" class="h-24 text-center text-muted-foreground">
              لایسنسی یافت نشد. از فرم بالا اولین لایسنس را بسازید.
            </td>
          </tr>
        ) : (
          licenses.map((license: any) => (
            <tr class="border-t border-border hover:bg-muted/30 transition-colors">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs bg-muted px-2 py-1 rounded inline-block" dir="ltr">
                    {license.code}
                  </span>
                  <button
                    type="button"
                    class="p-1 rounded text-muted-foreground hover:text-foreground hover:bg-muted text-xs cursor-pointer transition-colors"
                    title="کپی کد لایسنس"
                    onclick={`navigator.clipboard.writeText('${license.code}'); alert('کد لایسنس ${license.code} کپی شد!');`}
                  >
                    📋
                  </button>
                </div>
              </td>
              <td class="px-4 py-3">{license.plan_name || "—"}</td>
              <td class="px-4 py-3">
                <span class={`px-2 py-1 rounded-full text-xs ${
                  license.status === 'active' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' :
                  license.status === 'unused' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300' :
                  license.status === 'expired' ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300' :
                  'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300'
                }`}>
                  {license.status === 'active' ? 'فعال' : license.status === 'unused' ? 'استفاده نشده' : license.status === 'expired' ? 'منقضی' : 'لغو شده'}
                </span>
              </td>
              <td class="px-4 py-3">{toPersianDigits(license.active_device_count ?? 0)} / {toPersianDigits(license.max_devices)}</td>
              <td class="px-4 py-3 text-muted-foreground">{formatPersianDate(license.expires_at)}</td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  {(license.status === 'active' || license.status === 'unused') && (
                    <form method="post" action="/admin/licenses/action" class="inline">
                      <input type="hidden" name="id" value={license.id} />
                      <input type="hidden" name="action" value="extend" />
                      <input type="hidden" name="days" value="30" />
                      <button type="submit" class="rounded border border-border px-2 py-1 text-xs hover:bg-muted transition-colors">
                        تمدید ۳۰ روز
                      </button>
                    </form>
                  )}
                  {(license.status === 'active' || license.status === 'unused') && (
                    <form method="post" action="/admin/licenses/action" class="inline" onsubmit="return confirm('این لایسنس لغو شود؟')">
                      <input type="hidden" name="id" value={license.id} />
                      <input type="hidden" name="action" value="revoke" />
                      <button type="submit" class="rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950 transition-colors">
                        لغو
                      </button>
                    </form>
                  )}
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</Layout>
