---
import Layout from '@/layouts/Layout.astro';
import Flash from '@/components/admin/flash.astro';
import { SettingsService, SETTING_KEYS, maskSettingValue } from '@/lib/services/settings';
import { toPersianDigits, formatPersianDate, formatPersianTime } from '@/lib/i18n';
import { TelegramBotApi } from '@/lib/telegram/bot-api';
import { resolveBotToken } from '@/lib/telegram/bot-notifications';

const { DB } = Astro.locals.runtime.env;
const env = Astro.locals.runtime.env as any;
const sessionAdmin = Astro.locals.SESSION;

const settingsService = new SettingsService(DB);
const currentToken = await resolveBotToken(DB, env);

// Query Telegram directly if token exists
let botInfo: any = null;
let webhookInfo: any = null;
let telegramReachable = false;

if (currentToken) {
  try {
    const bot = new TelegramBotApi(currentToken);
    const [meRes, whRes] = await Promise.all([
      bot.getMe(),
      bot.getWebhookInfo(),
    ]);
    if (meRes.ok && meRes.result) {
      botInfo = meRes.result;
      telegramReachable = true;
    }
    if (whRes.ok && whRes.result) {
      webhookInfo = whRes.result;
    }
  } catch (err) {
    console.warn('[admin-bot] Telegram query error:', err);
  }
}

const adminsResult = await DB.prepare(
  `SELECT chat_id, full_name, telegram_username, role, is_active, last_command_at, created_at
   FROM bot_admins ORDER BY is_active DESC, created_at ASC`,
).all<{
  chat_id: number;
  full_name: string | null;
  telegram_username: string | null;
  role: string;
  is_active: number;
  last_command_at: string | null;
  created_at: string | null;
}>();
const admins = adminsResult.results || [];

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const errDetail = Astro.url.searchParams.get('msg');

const localOkMessages: Record<string, string> = {
  connected_and_verified: '🎉 ربات با موفقیت فعال شد، وب‌هوک متصل گردید و پیام تایید به تلگرام شما ارسال شد!',
  connected: '✅ وب‌هوک ربات تلگرام با موفقیت متصل و فعال گردید.',
  test_sent: '⚡ پیام تستی با موفقیت به تلگرام شما ارسال شد. تلگرام خود را چک کنید.',
  disconnected: 'وب‌هوک ربات با موفقیت غیرفعال شد.',
  added: 'مدیر جدید به ربات اضافه شد.',
  toggled: 'وضعیت دسترسی مدیر تغییر کرد.',
  removed: 'مدیر از فهرست حذف شد.',
};

const localErrMessages: Record<string, string> = {
  fields: 'لطفاً فیلدهای فرم را به درستی تکمیل فرمایید.',
  no_token: 'لطفاً ابتدا توکن ربات تلگرام را وارد کنید.',
  invalid_token: 'فرمت توکن نامعتبر است. نمونه: 123456789:ABCdefGhI...',
  invalid_chat_id: 'شناسه عددی تلگرام باید عددی باشد (مثلاً 123456789).',
  connect_failed: 'خطا در برقراری ارتباط با سرور تلگرام.',
  exists: 'این شناسه چت قبلاً در فهرست مدیران ثبت شده است.',
  no_admin: 'ابتدا شناسه عددی تلگرام خود را ثبت کنید.',
  test_failed: 'ارسال پیام تست ناموفق بود. مطمئن شوید حداقل یک‌بار ربات را استارت زده‌اید.',
};

const flashOk = ok && !localOkMessages[ok] ? ok : null;
const flashErr = err && !errDetail && !localErrMessages[err] ? err : null;
const localOk = ok ? localOkMessages[ok] || null : null;
const localErr = err ? errDetail || localErrMessages[err] || null : null;

const roleLabels: Record<string, string> = {
  super_admin: 'سوپر ادمین',
  admin: 'ادمین',
  read_only: 'فقط خواندن',
};

const isWebhookActive = Boolean(webhookInfo?.url && webhookInfo.url.includes('/api/bot/webhook'));
---

<Layout title="ربات تلگرام هوشمند">
  <Flash ok={flashOk} err={flashErr} />

  {localOk && (
    <div class="mb-5 rounded-lg border border-green-300 bg-green-50 px-4 py-3.5 text-sm font-medium text-green-900 dark:border-green-800 dark:bg-green-950 dark:text-green-200 shadow-xs flex items-center gap-2" role="alert">
      <span class="text-xl">✅</span>
      <span>{localOk}</span>
    </div>
  )}

  {localErr && (
    <div class="mb-5 rounded-lg border border-red-300 bg-red-50 px-4 py-3.5 text-sm font-medium text-red-900 dark:border-red-800 dark:bg-red-950 dark:text-red-200 shadow-xs flex items-center gap-2" role="alert">
      <span class="text-xl">⚠️</span>
      <span>{localErr}</span>
    </div>
  )}

  <!-- Live Status Hero Banner -->
  <div class={`kpi-card mb-6 border transition-all ${isWebhookActive ? 'border-emerald-300 dark:border-emerald-800/60 bg-gradient-to-l from-emerald-500/5 via-card to-card' : 'border-amber-300 dark:border-amber-800/60 bg-gradient-to-l from-amber-500/5 via-card to-card'}`}>
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-xs shrink-0 ${isWebhookActive ? 'bg-emerald-500 text-white shadow-emerald-500/20' : 'bg-amber-500 text-white shadow-amber-500/20'}`}>
          {isWebhookActive ? '🤖' : '⚙️'}
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-lg font-bold text-foreground">
              {botInfo?.first_name ? `ربات: ${botInfo.first_name}` : 'ربات تلگرام GoldPOS'}
            </h2>
            {botInfo?.username && (
              <a
                href={`https://t.me/${botInfo.username}`}
                target="_blank"
                rel="noreferrer"
                class="font-mono text-xs px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-bold hover:bg-primary/20 transition-colors"
                dir="ltr"
              >
                @{botInfo.username} ↗
              </a>
            )}
            <span class={`text-xs px-2.5 py-0.5 rounded-full font-bold ${isWebhookActive ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'}`}>
              {isWebhookActive ? '● متصل و آنلاین' : '○ در انتظار اتصال'}
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-1">
            {isWebhookActive
              ? 'وب‌هوک فعال است؛ تمام دستورات، کلیدهای شیشه‌ای و ناتیفیکیشن‌های ثبت‌نام در لحظه کار می‌کنند.'
              : 'برای شروع کار، توکن ربات و شناسه عددی تلگرام خود را در فرم زیر وارد کرده و دکمه اتصال را بزنید.'}
          </p>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      {isWebhookActive && (
        <div class="flex items-center gap-2 w-full md:w-auto">
          <form method="post" action="/admin/bot/action" class="w-full md:w-auto">
            <input type="hidden" name="action" value="test_message" />
            <button
              type="submit"
              class="w-full md:w-auto inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors cursor-pointer shadow-xs"
            >
              <span>⚡</span>
              <span>ارسال پیام تست به تلگرام</span>
            </button>
          </form>
          <form method="post" action="/admin/bot/action" onsubmit="return confirm('آیا از قطع اتصال وب‌هوک اطمینان دارید؟')">
            <input type="hidden" name="action" value="disconnect" />
            <button
              type="submit"
              class="px-3 py-2 rounded-lg border border-border hover:bg-destructive/10 hover:text-destructive text-muted-foreground text-xs font-medium transition-colors cursor-pointer"
            >
              قطع اتصال
            </button>
          </form>
        </div>
      )}
    </div>

    {webhookInfo?.url && (
      <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between flex-wrap gap-2 text-xs text-muted-foreground">
        <div class="flex items-center gap-2">
          <span>آدرس وب‌هوک فعال:</span>
          <code class="font-mono text-[11px] bg-muted px-2 py-0.5 rounded text-foreground" dir="ltr">{webhookInfo.url}</code>
        </div>
        <div>
          پیام‌های صف: <strong class="text-foreground">{toPersianDigits(webhookInfo.pending_update_count || 0)}</strong>
        </div>
      </div>
    )}
  </div>

  <!-- One-Click Setup Form: Token & Chat ID -->
  <div class="kpi-card mb-6 border-primary/20 shadow-md">
    <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-border">
      <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
        ⚡
      </div>
      <div>
        <h3 class="font-bold text-base text-foreground">راه‌اندازی و اتصال خودکار با یک کلیک</h3>
        <p class="text-xs text-muted-foreground">فقط توکن دریافتی از BotFather و شناسه عددی تلگرام خود را وارد کنید؛ بقیه کارها خودکار انجام می‌شود.</p>
      </div>
    </div>

    <form method="post" action="/admin/bot/action" class="space-y-4">
      <input type="hidden" name="action" value="quick_setup" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Field 1: Bot Token -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="bot_token" class="text-xs font-bold text-foreground flex items-center gap-1.5">
              <span>🔑 توکن ربات تلگرام (Bot Token)</span>
              <span class="text-destructive">*</span>
            </label>
            <a
              href="https://t.me/BotFather"
              target="_blank"
              rel="noreferrer"
              class="text-[11px] text-primary hover:underline"
            >
              دریافت از @BotFather ↗
            </a>
          </div>
          <input
            type="text"
            id="bot_token"
            name="bot_token"
            dir="ltr"
            placeholder={currentToken ? maskSettingValue(currentToken) : "7123456789:AAHk1234567890abcdef..."}
            class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary/40"
          />
          <p class="text-[11px] text-muted-foreground mt-1">
            {currentToken ? 'توکن قبلاً ثبت شده است. اگر می‌خواهید تغییر کند، توکن جدید را وارد کنید.' : 'توکن ربات را پس از ساخت در @BotFather در اینجا الصاق نمایید.'}
          </p>
        </div>

        <!-- Field 2: Admin Telegram Chat ID -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="chat_id" class="text-xs font-bold text-foreground flex items-center gap-1.5">
              <span>🆔 شناسه عددی چت شما (Chat ID)</span>
              <span class="text-destructive">*</span>
            </label>
            <a
              href="https://t.me/userinfobot"
              target="_blank"
              rel="noreferrer"
              class="text-[11px] text-primary hover:underline"
            >
              دریافت از @userinfobot ↗
            </a>
          </div>
          <input
            type="text"
            id="chat_id"
            name="chat_id"
            inputmode="numeric"
            dir="ltr"
            value={admins[0]?.chat_id ? String(admins[0].chat_id) : ""}
            placeholder="مثال: 123456789"
            class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary/40"
          />
          <p class="text-[11px] text-muted-foreground mt-1">
            شناسه کاربری عددی شما جهت دریافت ناتیفیکیشن ثبت‌نام‌ها و دسترسی به منوی شیشه‌ای ادمین.
          </p>
        </div>
      </div>

      <!-- Field 3: Admin Name (Optional) -->
      <div>
        <label for="admin_name" class="block text-xs font-medium text-muted-foreground mb-1.5">
          نام یا عنوان مدیر (اختیاری)
        </label>
        <input
          type="text"
          id="admin_name"
          name="admin_name"
          value={admins[0]?.full_name || sessionAdmin?.username || "مدیر اصلی"}
          placeholder="مثال: مدیریت طلافروشی"
          class="w-full max-w-md rounded-lg border border-border bg-background px-3.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40"
        />
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold px-7 py-3 text-sm transition-all shadow-md hover:shadow-lg cursor-pointer"
        >
          <span>⚡</span>
          <span>ذخیره، راه‌اندازی و اتصال خودکار ربات با یک کلیک</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Step-by-Step Visual Guide (راهنمای سریع و آسان) -->
  <div class="kpi-card mb-6 border-amber-200 dark:border-amber-900/40 bg-gradient-to-l from-amber-500/5 via-card to-card">
    <h3 class="font-bold text-sm text-foreground mb-3 flex items-center gap-2">
      <span class="text-xl">📖</span>
      <span>راهنمای ۳ مرحله‌ای و آسان راه‌اندازی ربات در کمتر از ۱ دقیقه</span>
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 text-xs">
      <div class="p-3.5 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-amber-600 dark:text-amber-400 text-sm">مرحله ۱: دریافت توکن</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-bold">۱</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            در تلگرام به ربات <b><a href="https://t.me/BotFather" target="_blank" rel="noreferrer" class="text-primary underline">@BotFather</a></b> بروید، دستور <code class="bg-muted px-1 rounded">/newbot</code> را بفرستید، یک نام و یک آیدی انتخاب کنید و توکن متنی دریافتی را کپی نمایید.
          </p>
        </div>
      </div>

      <div class="p-3.5 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 text-sm">مرحله ۲: دریافت شناسه چت</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 font-bold">۲</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            در تلگرام به ربات <b><a href="https://t.me/userinfobot" target="_blank" rel="noreferrer" class="text-primary underline">@userinfobot</a></b> پیام دهید تا عدد اختصاصی شما (مانند <code class="bg-muted px-1 rounded">123456789</code>) را به شما نشان دهد.
          </p>
        </div>
      </div>

      <div class="p-3.5 rounded-lg border border-border bg-background flex flex-col justify-between gap-2 shadow-xs">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">مرحله ۳: لمس دکمه اتصال</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold">۳</span>
          </div>
          <p class="text-muted-foreground leading-relaxed">
            هر دو مقدار را در کادرهای بالا قرار داده و دکمه اتصال را بزنید. وب‌هوک متصل شده و بلافاصله پیام تبریک و کلیدهای شیشه‌ای به تلگرام شما ارسال می‌شود!
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bot Admins Management Table -->
  <div class="kpi-card mb-6">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <div>
        <h3 class="font-bold text-base text-foreground">مدیران مجاز ربات تلگرام</h3>
        <p class="text-xs text-muted-foreground">فقط شناسه‌های ثبت‌شده در این فهرست اجازه اجرای دستورات، صدور لایسنس و دریافت ناتیفیکیشن را دارند.</p>
      </div>

      <details class="text-xs">
        <summary class="cursor-pointer font-bold px-3 py-1.5 rounded-lg border border-border hover:bg-muted text-primary select-none">
          + افزودن دستی مدیر دیگر
        </summary>
        <form method="post" action="/admin/bot/action" class="mt-3 p-3 rounded-lg border border-border bg-muted/40 space-y-2">
          <input type="hidden" name="action" value="add" />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <input
              type="text"
              name="chat_id"
              inputmode="numeric"
              required
              placeholder="شناسه عددی تلگرام *"
              class="rounded border border-border bg-background px-2.5 py-1.5 text-xs"
            />
            <input
              type="text"
              name="full_name"
              placeholder="نام کامل مدیر"
              class="rounded border border-border bg-background px-2.5 py-1.5 text-xs"
            />
            <select name="role" class="rounded border border-border bg-background px-2.5 py-1.5 text-xs">
              <option value="super_admin">سوپر ادمین (دسترسی کامل)</option>
              <option value="admin">ادمین عادی</option>
              <option value="read_only">فقط مشاهده آمار</option>
            </select>
          </div>
          <button type="submit" class="w-full sm:w-auto px-4 py-1.5 rounded bg-primary text-primary-foreground font-bold text-xs cursor-pointer">
            ثبت مدیر جدید
          </button>
        </form>
      </details>
    </div>

    {admins.length === 0 ? (
      <div class="text-center py-8 text-xs text-muted-foreground border border-dashed rounded-lg">
        هنوز هیچ مدیری ثبت نشده است. از فرم بالای صفحه شناسه عددی تلگرام خود را وارد فرمایید.
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead>
            <tr class="border-b border-border text-muted-foreground">
              <th class="py-2.5 px-3">شناسه چت</th>
              <th class="py-2.5 px-3">نام مدیر</th>
              <th class="py-2.5 px-3">نام کاربری</th>
              <th class="py-2.5 px-3">نقش</th>
              <th class="py-2.5 px-3">وضعیت</th>
              <th class="py-2.5 px-3">آخرین ارتباط</th>
              <th class="py-2.5 px-3 text-left">عملیات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {admins.map((adm: any) => (
              <tr class="hover:bg-muted/30 transition-colors">
                <td class="py-3 px-3 font-mono" dir="ltr">
                  <code>{adm.chat_id}</code>
                </td>
                <td class="py-3 px-3 font-medium text-foreground">
                  {adm.full_name || '—'}
                </td>
                <td class="py-3 px-3 font-mono text-muted-foreground" dir="ltr">
                  {adm.telegram_username ? `@${adm.telegram_username}` : '—'}
                </td>
                <td class="py-3 px-3">
                  <span class="px-2 py-0.5 rounded text-[11px] bg-muted font-bold text-foreground">
                    {roleLabels[adm.role] || adm.role}
                  </span>
                </td>
                <td class="py-3 px-3">
                  <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold ${adm.is_active ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300'}`}>
                    {adm.is_active ? 'فعال' : 'غیرفعال'}
                  </span>
                </td>
                <td class="py-3 px-3 text-muted-foreground text-[11px]">
                  {adm.last_command_at ? formatPersianDate(adm.last_command_at) : 'تاکنون پیامی نداده'}
                </td>
                <td class="py-3 px-3 text-left">
                  <div class="flex items-center justify-end gap-1.5">
                    <form method="post" action="/admin/bot/action">
                      <input type="hidden" name="action" value="toggle" />
                      <input type="hidden" name="chat_id" value={adm.chat_id} />
                      <button
                        type="submit"
                        class="px-2 py-1 rounded border border-border text-[11px] hover:bg-muted cursor-pointer"
                        title={adm.is_active ? 'غیرفعال کردن دسترسی' : 'فعال کردن دسترسی'}
                      >
                        {adm.is_active ? 'غیرفعال' : 'فعال‌سازی'}
                      </button>
                    </form>
                    <form method="post" action="/admin/bot/action" onsubmit="return confirm('آیا از حذف این مدیر اطمینان دارید؟')">
                      <input type="hidden" name="action" value="remove" />
                      <input type="hidden" name="chat_id" value={adm.chat_id} />
                      <button
                        type="submit"
                        class="px-2 py-1 rounded border border-border text-[11px] text-destructive hover:bg-destructive/10 cursor-pointer"
                        title="حذف مدیر"
                      >
                        حذف
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

