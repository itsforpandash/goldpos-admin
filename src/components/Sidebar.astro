---
const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/admin' ? currentPath === '/admin' : currentPath.startsWith(href);

type NavItem = { href: string; label: string; icon: string };

const s = 'xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';

const items: NavItem[] = [
  {
    href: '/admin',
    label: 'داشبورد',
    icon: `<svg ${s}><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>`,
  },
  {
    href: '/admin/users',
    label: 'کاربران',
    icon: `<svg ${s}><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    href: '/admin/licenses',
    label: 'لایسنسها',
    icon: `<svg ${s}><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`,
  },
  {
    href: '/admin/devices',
    label: 'دستگاهها',
    icon: `<svg ${s}><rect width="5" height="4" x="2" y="3" rx="1"/><path d="M4 7V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/><path d="M2 11h20"/><path d="M4 11v4a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2v-4"/><path d="M16 17v-4a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v4"/><path d="M9 17h6"/></svg>`,
  },
  {
    href: '/admin/plans',
    label: 'پلنها',
    icon: `<svg ${s}><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    href: '/admin/signup',
    label: 'درخواست‌های ثبت‌نام',
    icon: `<svg ${s}><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>`,
  },
  {
    href: '/admin/bot',
    label: 'ربات تلگرام',
    icon: `<svg ${s}><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>`,
  },
  {
    href: '/admin/activity',
    label: 'فعالیت‌ها',
    icon: `<svg ${s}><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>`,
  },
  {
    href: '/admin/settings',
    label: 'تنظیمات',
    icon: `<svg ${s}><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
];
---

<div class="flex flex-col h-full">
  {/* Logo (+ close button, only meaningful inside the mobile drawer) */}
  <div class="flex items-center gap-3 px-6 py-4 border-b border-gray-200 dark:border-gray-800">
    <div class="w-8 h-8 shrink-0 rounded-lg bg-primary flex items-center justify-center text-white font-bold text-sm">G</div>
    <div class="min-w-0 flex-1">
      <div class="font-bold text-foreground text-sm">GoldPos</div>
      <div class="text-xs text-muted-foreground">پنل مدیریت</div>
    </div>
    <button
      type="button"
      class="js-close-drawer lg:hidden -ms-1 min-h-11 min-w-11 shrink-0 inline-flex items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
      aria-label="بستن منو"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
  </div>

  {/* Navigation */}
  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-primary/10 text-primary'
              : 'text-muted-foreground hover:bg-gray-100 dark:hover:bg-gray-800',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="shrink-0" set:html={item.icon} />
          <span class="min-w-0 truncate">{item.label}</span>
        </a>
      ))
    }
  </nav>

  {/* Footer */}
  <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-800 text-xs text-muted-foreground">
    GoldPos Admin v1.0
  </div>
</div>
