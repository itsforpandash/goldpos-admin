---
import '@/styles/globals.css'
import Sidebar from '@/components/Sidebar.astro';
import { Button } from '@/components/ui/button';
import { LogOut, Menu } from 'lucide-react';

const title = Astro.props.title || 'داشبورد';
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0ea5e9" />
    <title>{title ? `${title} - GoldPos` : 'GoldPos Admin'}</title>
    <script is:inline>
      // Theme bootstrap — must only touch <html> because it runs before <body>.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');
        try {
          var observer = new MutationObserver(function () {
            try {
              localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
            } catch (e) {}
          });
          observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <div class="flex h-[100dvh] overflow-hidden" id="app-root">
      <!-- Desktop Sidebar (>=1024px) -->
      <aside class="hidden lg:flex flex-shrink-0 w-64 flex-col border-l border-border bg-card">
        <Sidebar />
      </aside>

      <!-- Mobile drawer backdrop -->
      <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/50 z-30 lg:hidden" aria-hidden="true"></div>

      <!-- Mobile drawer: right-anchored (RTL start side), hidden via #mobile-sidebar transform in globals.css -->
      <aside
        id="mobile-sidebar"
        class="lg:hidden fixed top-0 right-0 h-full w-72 max-w-[85vw] overflow-y-auto bg-card border-l border-border shadow-2xl z-40 transition-transform duration-200"
        aria-label="منوی پنل"
        aria-hidden="true"
        inert
      >
        <Sidebar />
      </aside>

      <!-- Main content column -->
      <div class="flex-1 flex flex-col overflow-hidden min-w-0">
        <!-- Top header: menu button + page title on mobile, brand on desktop -->
        <header class="flex items-center justify-between gap-2 px-3 sm:px-4 py-2.5 bg-card border-b border-border">
          <div class="flex items-center gap-2 sm:gap-3 min-w-0">
            <Button
              variant="ghost"
              size="icon"
              id="menu-btn"
              class="lg:hidden shrink-0 min-h-11 min-w-11"
              aria-label="باز کردن منو"
              aria-expanded="false"
              aria-controls="mobile-sidebar"
            >
              <Menu class="w-5 h-5" />
            </Button>
            <span class="lg:hidden text-base font-bold truncate">{title}</span>
            <span class="hidden lg:block text-lg font-bold text-primary">GoldPos</span>
          </div>
          <div class="flex items-center gap-2 sm:gap-4 shrink-0">
            <button
              type="button"
              id="theme-toggle"
              class="min-h-11 px-1 flex items-center gap-1 text-xs sm:text-sm text-muted-foreground hover:text-foreground cursor-pointer"
              aria-label="تغییر تم"
            >
              <span class="theme-icon" aria-hidden="true">🌙</span>
              <span class="theme-label">تم تیره</span>
            </button>
            <a
              href="/admin/logout"
              class="min-h-11 px-1 flex items-center gap-1 text-xs sm:text-sm text-muted-foreground hover:text-foreground cursor-pointer"
            >
              <LogOut class="w-4 h-4" />
              <span>خروج</span>
            </a>
          </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-6 min-w-0">
          <div class="flex items-center justify-between mb-5 sm:mb-6 flex-wrap gap-4">
            <h1 class="hidden lg:block text-2xl font-bold tracking-tight">{title}</h1>
            <slot name="actions" />
          </div>
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var drawer = document.getElementById('mobile-sidebar');
        var overlay = document.getElementById('sidebar-overlay');
        var menuBtn = document.getElementById('menu-btn');

        function setDrawer(open) {
          if (!drawer || !overlay || !menuBtn) return;
          drawer.classList.toggle('is-open', open);
          overlay.classList.toggle('hidden', !open);
          drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          try { drawer.inert = !open; } catch (e) {}
          if (open) {
            var first = drawer.querySelector('a[href], button');
            if (first && first.focus) first.focus();
          }
        }

        function isOpen() {
          return !!drawer && drawer.classList.contains('is-open');
        }

        if (menuBtn && drawer && overlay) {
          menuBtn.addEventListener('click', function () { setDrawer(!isOpen()); });
          overlay.addEventListener('click', function () { setDrawer(false); });

          document.addEventListener('keydown', function (e) {
            if ((e.key === 'Escape' || e.key === 'Esc') && isOpen()) {
              setDrawer(false);
              menuBtn.focus();
            }
          });

          // Close when a nav link inside the drawer is tapped, or when a
          // close affordance (X) inside the drawer is tapped.
          drawer.addEventListener('click', function (e) {
            var target = e.target;
            if (!target || !target.closest) return;
            if (target.closest('.js-close-drawer')) {
              e.preventDefault();
              setDrawer(false);
              menuBtn.focus();
            } else if (target.closest('a[href]')) {
              setDrawer(false);
            }
          });

          // Leaving the mobile breakpoint: reset state so the drawer is
          // clean if the user rotates/resizes back down.
          window.addEventListener('resize', function () {
            if (window.innerWidth >= 1024 && isOpen()) setDrawer(false);
          });
        }

        // Theme toggle
        var themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', function () {
            var isDark = document.documentElement.classList.toggle('dark');
            var icon = document.querySelector('.theme-icon');
            var label = document.querySelector('.theme-label');
            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
            if (label) label.textContent = isDark ? 'تم روشن' : 'تم تیره';
          });
        }

        // PWA service worker registration
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function (err) {
              console.warn('SW registration failed:', err);
            });
          });
        }
      })();
    </script>
  </body>
</html>
